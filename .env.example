SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001/api
# Use your deployed site URL in production, for example https://clinic.example.com/login.
VITE_AUTH_REDIRECT_URL=http://localhost:5173/login

# Server-only transactional email settings. Never use VITE_ prefixes or put
# these values in frontend code. Gmail requires Google 2-Step Verification and
# an App Password. The sender is the Gmail account itself.
EMAIL_PROVIDER=gmail
GMAIL_USER=clinic@gmail.com
GMAIL_APP_PASSWORD=your-16-character-google-app-password
ADMIN_EMAIL=clinic-owner@example.com

# Optional Resend alternative. It requires a verified domain.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxx
# EMAIL_FROM=Bright Smile Dental <hello@your-domain.com>

# Server-side automatic no-show check. Visits are marked no-show only after
# their scheduled end time. Default: 15 minutes.
NO_SHOW_CHECK_INTERVAL_MINUTES=15
# Mark an overdue appointment as no-show this many minutes after its start time.
NO_SHOW_GRACE_MINUTES=60
CRON_SECRET=use-a-long-random-secret-for-vercel-cron
