SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3001
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:3001/api
# Use your deployed site URL in production, for example https://clinic.example.com/login.
VITE_AUTH_REDIRECT_URL=http://localhost:5173/login

# Server-only Gmail notification settings.
GMAIL_USER=your-clinic@gmail.com
GMAIL_APP_PASSWORD=
BOOKING_NOTIFICATION_EMAIL=your-clinic@gmail.com

# Server-side automatic no-show check. Visits are marked no-show only after
# their scheduled end time. Default: 15 minutes.
NO_SHOW_CHECK_INTERVAL_MINUTES=15
# Mark an overdue appointment as no-show this many minutes after its start time.
NO_SHOW_GRACE_MINUTES=60
CRON_SECRET=use-a-long-random-secret-for-vercel-cron
